# Prefer the Session pooler URI from Supabase dashboard (works on IPv4 networks):
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxx.supabase.co:5432/postgres
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
AI_SERVICE_URL=http://127.0.0.1:8000
CLIENT_URL=http://127.0.0.1:5173
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
# Lesson doubt assistant — any OpenAI-compatible chat API. Leave empty to use the built-in tutor.
# Gemini (free tier): LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.0-flash
# Groq (free tier):   LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.1-8b-instant
# OpenAI:             LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
# Ollama (local):     LLM_BASE_URL=http://127.0.0.1:11434/v1  LLM_MODEL=llama3.2 (no key needed)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
